# The website's own PostgreSQL: the programmes to look up are read from "Program", the results are written to
# "KeywordSignal". Role: SELECT on "Program", SELECT/INSERT/UPDATE on "KeywordSignal" (see README).
# Leave empty to look up only what is posted to /keywords.
SITE_DB_URL=postgresql://keywords:password@127.0.0.1:5432/topaffiliate
KEYWORD_FARM_ENABLED=true
# Google Ads account the Keyword Planner is opened under
KEYWORD_FARM_MCC_NAME=Long NT Manager
KEYWORD_FARM_CLIENT_ACCOUNT_ID=264-579-6190
# Local state and Chrome profile live under ./data (mounted by compose)
RAM_PAUSE_PCT=87
RAM_EMERGENCY_PCT=95

# --- database read/write budget ---
FEED_LOW_WATER=200            # consider a pull only when fewer jobs than this are pending
FEED_BATCH=1000               # rows per candidate page (keyset cursor in SQLite)
FEED_MIN_INTERVAL_S=600       # at most one page per 10 minutes
FEED_EXHAUSTED_WAIT_S=3600    # backlog exhausted -> look again in 1h
FEED_CURSOR_RESET_S=86400     # restart from the head daily to catch new domains
REQUEUE_AFTER_S=1209600       # a finished domain is queued again after 14 days
FLUSH_MIN_ROWS=20
FLUSH_MAX_AGE_S=300
JOB_LEASE_S=7200              # > longest farm session
MAX_QUEUE_PENDING=20000
DB_POOL_MAX=2

# --- keyword history: a domain is looked up again after this many days; every lookup also appends a history row ---
KEYWORD_RECHECK_DAYS=30

# --- who gets looked up: with SITE_DB_URL set, the programmes published on the website; otherwise only the domains handed in. ---
FEED_AUTO=false

